rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /staging/{uid}/{file} {
      allow write: if request.auth != null && request.auth.uid == uid && request.resource.size < 500 * 1024;
      allow read: if request.auth != null;
    }
    match /requests/{requestId}/{file} {
      allow write: if request.auth != null && request.resource.size < 500 * 1024;
      allow read: if request.auth != null;
    }
  }
}
